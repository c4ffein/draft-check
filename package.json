{
  "name": "draft-check",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "build": "tsc --noEmit && bun src/build.ts",
    "lint": "oxlint --react-plugin -W suspicious -W perf -A react/react-in-jsx-scope -A no-await-in-loop --ignore-pattern dist",
    "preview": "bunx --bun serve dist --single -l 8080",
    "test": "bun test"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "bun-plugin-tailwind": "^0.0.15",
    "oxlint": "^1.27.0",
    "typescript": "~6.0.2"
  }
}
